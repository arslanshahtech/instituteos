# API server
# Managed hosts provide PORT automatically; the API honours PORT before API_PORT.
# Local development uses 127.0.0.1:4000. Production defaults to 0.0.0.0 when API_HOST is unset.
API_HOST=127.0.0.1
API_PORT=4000
NODE_ENV=development
API_TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=120
API_SHUTDOWN_TIMEOUT_MS=10000

# Authentication session and verification
# Optional; set only for HTTPS frontend/API subdomains of the same owned domain.
# Example: .example.pk. Leave blank for same-origin deployment/local development.
AUTH_CSRF_COOKIE_DOMAIN=
AUTH_SESSION_TTL_DAYS=7
# Exactly one allowlisted email can receive the initial platform-admin grant.
PLATFORM_ADMIN_EMAIL=
AUTH_COOKIE_SECURE=
AUTH_REQUIRE_EMAIL_VERIFICATION=
AUTH_WEB_APP_URL=http://127.0.0.1:5173

# Optional SMTP delivery for verification and password-reset email.
# Delivery is enabled only when SMTP_HOST, SMTP_USER, SMTP_PASSWORD, and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# MongoDB (local development default; use a secret-managed URI outside local development)
MONGODB_URI=mongodb://127.0.0.1:27017/instituteos
MONGODB_SERVER_SELECTION_TIMEOUT_MS=20000
MONGODB_RETRY_DELAY_MS=5000

# Browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Frontend development server
WEB_HOST=127.0.0.1
WEB_PORT=5173
VITE_API_BASE_URL=/api/v1
